{
    // ==================
    // EDITOR SETTINGS
    // ==================
    "editor.formatOnSave": true,
    // Global fallback (overridden by specific languages below)
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll": "explicit"
    },
    "editor.rulers": [
        88
    ],
    // ==================
    // LANGUAGE-SPECIFIC FORMATTING
    // ==================
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
        }
    },
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    // NEW: Auto-fix Markdown issues (headers, spacing)
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.markdownlint": "explicit"
        }
    },
    // ==================
    // PYTHON CONFIGURATION
    // ==================
    "python.terminal.activateEnvironment": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.analysis.extraPaths": [
        "./src"
    ],
    // Disabled Pylance type checking to let Mypy be the authority
    "python.analysis.typeCheckingMode": "",
    // Black formatter settings
    "black-formatter.args": [
        "--line-length=88",
        "--preview"
    ],
    // Ruff linter settings
    "ruff.enable": true,
    "ruff.lint.enable": true,
    // Mypy settings
    "mypy-type-checker.reportingScope": "workspace",
    "mypy-type-checker.args": [
        "--ignore-missing-imports",
        "--disallow-untyped-defs",
        "--check-untyped-defs"
    ],
    // ==================
    // FILE EXCLUSIONS
    // ==================
    "files.exclude": {
        "**/.ipynb_checkpoints": true,
        "__pycache__": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/*.pyd": true,
        "**/*.db": true,
        "**/*.sqlite3": true,
        ".pytest_cache/": true,
        ".data": true,
        ".mypy_cache/": true,
        ".ruff_cache/": true
    },
    // ==================
    // TERMINAL SETTINGS
    // ==================
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // ==================
    // COPILOT SETTINGS
    // ==================
    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".github/copilot-instructions.md"
        },
        {
            "text": "Commit messages should use hybrid academic–software format. Include experiment context, dataset version, or model scope when relevant."
        }
    ],
    // ==================
    // TOKEN CUSTOMIZATION
    // ==================
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "docstring.heading.placeholder",
                "settings": {
                    "fontStyle": "bold underline",
                    "foreground": "#569cd6"
                }
            }
        ]
    }
}
